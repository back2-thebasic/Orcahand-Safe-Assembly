From 6a3e0760b2136402740cd18a05215d706f24d422 Mon Sep 17 00:00:00 2001
From: LynnUoE <linxuanc@usc.edu>
Date: Sun, 27 Sep 2026 22:36:46 -0700
Subject: [PATCH 3/8] Gesture tasks: stop penalising completed stages; make the
 stage observable

1. The progress term is the change in distance to the *current* target
   pose, and it was not re-based when the target advanced, so the jump to
   the next pose was charged: a scripted fist run lost 5.3, 4.0 and 9.1 on
   its three stage transitions. PPO trained 10M steps on HandFist-v0 at 0%
   success. The metric is now re-based on the new target (scripted return
   99.8 -> 118.2).

2. The stage one-hot only followed the scripted controller's bookkeeping,
   so any other policy always observed [1, 0, 0] -- the opening and closing
   "open" targets looked identical. For gestures it now follows the
   gesture index; every sequence starts from the open reset pose and has
   at most three targets after it, so each gets its own slot and the
   observation stays 73-wide.

Both are covered in tests/test_rl_exploits.py (they fail on the previous
code).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/orca_sim/taskgen/generic_env.py | 19 ++++++++++++++-
 tests/test_rl_exploits.py           | 37 +++++++++++++++++++++++++++++
 2 files changed, 55 insertions(+), 1 deletion(-)

diff --git a/src/orca_sim/taskgen/generic_env.py b/src/orca_sim/taskgen/generic_env.py
index d973ad3..f7f3032 100644
--- a/src/orca_sim/taskgen/generic_env.py
+++ b/src/orca_sim/taskgen/generic_env.py
@@ -335,7 +335,16 @@ class GeneratedOrcaEnv(BaseOrcaHandEnv):
                 ]
             )
         stage = np.zeros(3, dtype=np.float64)
-        stage[min(self._script_stage, 2)] = 1.0
+        if self.family == "gesture":
+            # Which target the hand is on. `_script_stage` only moves when the
+            # scripted controller runs, so under any other policy this read
+            # [1, 0, 0] forever, and "open" at the start and "open" at the end
+            # were the same observation. Every gesture sequence starts from
+            # the open reset pose (index 0 is met on step 1) and has at most
+            # three targets after it, so each remaining target gets its own slot.
+            stage[min(max(self._gesture_index - 1, 0), 2)] = 1.0
+        else:
+            stage[min(self._script_stage, 2)] = 1.0
         progress = np.asarray([self._elapsed_steps / max(self.max_episode_steps, 1)], dtype=np.float64)
         return np.concatenate(
             [
@@ -440,6 +449,7 @@ class GeneratedOrcaEnv(BaseOrcaHandEnv):
         self._elapsed_steps += 1
         contacts = self._contact_flags()
         self._grasped = bool(sum(contacts) >= 2)
+        gesture_index_before = self._gesture_index
         if (
             self._grasped
             and self._object_qpos_adr is not None
@@ -450,6 +460,13 @@ class GeneratedOrcaEnv(BaseOrcaHandEnv):
         self._advance_success()
 
         metric = self._metric()
+        if self._gesture_index != gesture_index_before:
+            # The metric is the distance to the *current* target. When the
+            # target advances it jumps (the next pose is far away) and the
+            # progress term charged that jump: reaching half-close, fist and
+            # open again cost -5.3, -4.0 and -9.1 in a scripted run, so every
+            # stage a policy completed was punished. Re-base on the new target.
+            self._previous_metric = metric
         reward_spec = self.task["reward"]
         reward = float(reward_spec["progress"]) * (metric - self._previous_metric)
         # Grasp shaping is potential-based: paid when a grasp is made, taken back
diff --git a/tests/test_rl_exploits.py b/tests/test_rl_exploits.py
index b507703..a8c4d88 100644
--- a/tests/test_rl_exploits.py
+++ b/tests/test_rl_exploits.py
@@ -88,3 +88,40 @@ def test_zero_action_never_succeeds() -> None:
                 break
         assert not info["is_success"], bundle
         env.close()
+
+
+def test_completing_a_gesture_stage_is_not_penalised() -> None:
+    # The progress term used to charge the jump in distance when the target
+    # pose advanced: -5.3, -4.0 and -9.1 for the three stages of the fist.
+    env = load_environment(EXAMPLES / "handfist_v0")
+    env.reset(seed=0)
+    index, stage_rewards = 0, []
+    for _ in range(env.max_episode_steps):
+        _, reward, terminated, truncated, info = env.step(env.scripted_action())
+        if info["gesture_index"] != index:
+            stage_rewards.append(reward)
+            index = info["gesture_index"]
+        if terminated or truncated:
+            break
+    env.close()
+    assert info["is_success"]
+    assert stage_rewards and min(stage_rewards) > -1.0, stage_rewards
+
+
+def test_gesture_stage_is_observable_without_the_script() -> None:
+    # The stage slots only followed the scripted controller, so any other
+    # policy always saw [1, 0, 0]. Drive the hand through the sequence by
+    # setting the targets directly and read the slots the policy would see.
+    env = load_environment(EXAMPLES / "handfist_v0")
+    obs, _ = env.reset(seed=0)
+    seen = {}
+    for _ in range(env.max_episode_steps):
+        action = env.scripted_action()
+        env._script_stage = 0          # keep the script's own bookkeeping out of it
+        obs, _, terminated, truncated, info = env.step(action)
+        seen.setdefault(info["gesture_index"], tuple(obs[-4:-1]))
+        if terminated or truncated:
+            break
+    env.close()
+    stages = [seen[i] for i in sorted(seen) if i >= 1]
+    assert len(stages) == 3 and len(set(stages)) == 3, seen
