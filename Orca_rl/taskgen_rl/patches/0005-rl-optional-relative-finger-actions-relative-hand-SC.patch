index 0000000..2979bf3
--- /dev/null
+++ b/rl/wrappers.py
@@ -0,0 +1,60 @@
+"""Training-side wrappers for generated task bundles.
+
+These change how the policy drives the environment, not the task: reward,
+success and the environment's own action space are untouched, so a policy
+trained through a wrapper is scored exactly like the scripted controller.
+"""
+
+from __future__ import annotations
+
+import gymnasium as gym
+import numpy as np
+
+from orca_sim.taskgen import load_environment
+
+
+class RelativeHandAction(gym.Wrapper):
+    """Finger actions move the servo targets instead of setting them.
+
+    The environment takes absolute finger targets, so holding a pose means
+    emitting the same 17 numbers every step. With exploration noise and a
+    0.05 (RMS, in half-spans) gesture tolerance, PPO got its deterministic
+    policy no closer than 0.085 to the half-close pose in 10M steps. Here each
+    step adds ``scale * a`` half-spans to the previous target, so zero action
+    holds; the wrist (first 6 dims) is already relative in the environment and
+    passes through. The current targets are appended to the observation, since
+    the joints lag them.
+    """
+
+    def __init__(self, env: gym.Env, scale: float) -> None:
+        super().__init__(env)
+        self.scale = float(scale)
+        base = env.unwrapped
+        self._n_hand = len(base._ctrl_halfspan)
+        self._target = np.zeros(self._n_hand, dtype=np.float64)
+        low = np.concatenate([env.observation_space.low, -np.ones(self._n_hand)]).astype(np.float32)
+        high = np.concatenate([env.observation_space.high, np.ones(self._n_hand)]).astype(np.float32)
+        self.observation_space = gym.spaces.Box(low=low, high=high, dtype=np.float32)
+
+    def _obs(self, obs: np.ndarray) -> np.ndarray:
+        return np.concatenate([obs, self._target]).astype(np.float32)
+
+    def reset(self, **kwargs):
+        obs, info = self.env.reset(**kwargs)
+        base = self.env.unwrapped
+        self._target = np.clip((base.data.ctrl[: self._n_hand] - base._ctrl_center) / base._ctrl_halfspan, -1.0, 1.0)
+        return self._obs(obs), info
+
+    def step(self, action):
+        action = np.clip(np.asarray(action, dtype=np.float64), -1.0, 1.0)
+        self._target = np.clip(self._target + self.scale * action[6:], -1.0, 1.0)
+        absolute = np.concatenate([action[:6], self._target]).astype(np.float32)
+        obs, reward, terminated, truncated, info = self.env.step(absolute)
+        return self._obs(obs), reward, terminated, truncated, info
+
+
+def make_env(bundle: str, relative_hand: float | None = None) -> gym.Env:
+    env = load_environment(bundle)
+    if relative_hand:
+        env = RelativeHandAction(env, relative_hand)
+    return env
