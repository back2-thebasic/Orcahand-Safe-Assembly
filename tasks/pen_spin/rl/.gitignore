# Only the baseline (track003_5), the last run before disturbances (track003_8)
# and the latest run (track003_10) are kept in git, without their checkpoints
# and tensorboard logs; training logs stay local.
runs/*/
!runs/track003_5/
!runs/track003_8/
!runs/track003_10/
!runs/quicktests/
!runs/stage_eval/
runs/*/checkpoints/
runs/*/tb/
runs/*.log
